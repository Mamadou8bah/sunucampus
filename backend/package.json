{
  "name": "sunucampus-backend",
  "version": "1.0.0",
  "description": "SunuCampus REST API and real-time server",
  "private": true,
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed:admin": "node --env-file-if-exists=.env scripts/seedAdmin.js",
    "photos:more": "node --env-file-if-exists=.env scripts/fetchMorePhotos.js",
    "photos:assign": "node --env-file-if-exists=.env scripts/assignDemoPhotos.js",
    "demo:export": "node --env-file-if-exists=.env scripts/exportDemoSnapshot.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seedDemo.js",
    "seed:notifications": "node --env-file-if-exists=.env scripts/seedNotifications.js --reset",
    "photos:fetch": "node --env-file-if-exists=.env scripts/fetchDemoPhotos.js",
    "photos:listings": "node --env-file-if-exists=.env scripts/fetchListingPhotos.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0"
  }
}
