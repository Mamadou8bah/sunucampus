NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sunucampus
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional: restrict registration to these email domains (comma-separated), e.g. utg.edu.gm
ALLOWED_EMAIL_DOMAINS=

# Set to true to run without a local MongoDB install (data is lost on restart)
USE_MEMORY_DB=false
# With USE_MEMORY_DB=true, also load demo students, posts, communities and messages
SEED_DEMO=false

# Email domains that earn the verified blue tick (comma-separated)
VERIFIED_EMAIL_DOMAINS=utg.edu.gm

# Outgoing email for verification codes. Leave SMTP_HOST empty to print codes in the server log (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SunuCampus <no-reply@sunucampus.local>

# Initial administrator created by `npm run seed:admin` (and automatically when USE_MEMORY_DB=true)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@sunucampus.local
ADMIN_PASSWORD=ChangeMe123

# Optional: free key from https://unsplash.com/developers, used by `npm run photos:fetch` for demo profile photos
UNSPLASH_ACCESS_KEY=
